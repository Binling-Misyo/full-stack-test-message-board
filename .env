# ==============================================================
# 环境变量配置文件（.env）
# 作用：存储数据库连接信息等敏感配置
#        这些信息不应该直接写在代码中，而是通过环境变量传入
# 关系：api/app.js 和 api/messages.js 通过 process.env 读取这里的变量
# 学习要点：
#   - 环境变量（Environment Variables）的概念
#   - .env 文件的格式：KEY=VALUE
#   - 敏感信息（密码、密钥）不应该提交到 Git 仓库
#   - # 开头的行是注释
# ==============================================================

# ===== 数据库连接配置 =====

# DATABASE_URL 是 PostgreSQL 的连接字符串
# 格式：postgresql://用户名:密码@主机地址:端口号/数据库名
# 这是 Supabase 提供的连接方式，一行包含所有连接信息
DATABASE_URL=postgresql://postgres.oehoyhwfggjgjapvrwoa:A7418624521a@aws-1-ap-northeast-1.pooler.supabase.com:5432/postgres

# 或者使用单独变量（二选一）
# 如果不用 DATABASE_URL，可以分别设置以下变量：
# DB_HOST=localhost          # 数据库主机地址
# DB_USER=postgres           # 数据库用户名
# DB_PASSWORD=A7418624521a   # 数据库密码
# DB_NAME=postgres           # 数据库名称
# DB_PORT=5432               # 数据库端口号（PostgreSQL 默认 5432）